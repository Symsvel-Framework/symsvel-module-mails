{
    "name": "symsvel-framework/module-mails",
    "description": "SymSvel module Mails",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/mailer": "^8.1",
        "twig/twig": "^3.0",
        "symsvel-framework/module-settings": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\Mails\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\Mails\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symsvel-framework/module-acls": "dev-dev"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist --display-skipped",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-settings.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-acls.git"
        }
    ]
}
